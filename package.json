{
  "name": "datetimechecker",
  "version": "1.0.0",
  "description": "Spring Boot REST API kiểm tra ngày/tháng/năm hợp lệ theo lịch Gregorian.",
  "main": "playwright.config.js",
  "scripts": {
    "test:e2e": "playwright test --project=\"Desktop Chrome\"",
    "ai:generate": "node scripts/generate-ai-tests.js",
    "test:ai:generated": "playwright test e2e/ai-generated.spec.js --project=\"Desktop Chrome\" --reporter=./scripts/ai-console-reporter.js",
    "test:ai": "npm run ai:generate && npm run test:ai:generated",
    "test:mobile": "node e2e/run-browserstack-mobile.js",
    "test:mobile:browserstack": "node e2e/run-browserstack-mobile.js",
    "generate:test-data": "node generate-test-data.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhatnhm1405/datetimechecker.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/nhatnhm1405/datetimechecker/issues"
  },
  "homepage": "https://github.com/nhatnhm1405/datetimechecker#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "browserstack-local": "^1.5.13",
    "browserstack-node-sdk": "^1.63.1",
    "mocha": "^11.7.5",
    "playwright": "^1.61.1",
    "selenium-webdriver": "^4.45.0"
  },
  "directories": {
    "doc": "docs"
  }
}
